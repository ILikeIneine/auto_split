{
  "manifest_version": 3,
  "name": "Auto Split · 链接右侧打开",
  "version": "1.0.1",
  "description": "点击网页链接，在 Chrome 原生 Split View 右侧打开，并保留左侧页面。",
  "minimum_chrome_version": "155",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Auto Split",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true
  }]
}
